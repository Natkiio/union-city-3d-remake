extends Node
## Autoload "Sfx": procedural placeholder sounds. No audio files: samples are
## generated by SfxSynth on first use and cached. Owner: audio workstream.
## Hook list and bus layout: docs/audio.md.
## Not stateful: volumes are settings (the ui Settings class), not run state, so a
## save must not change them. to_dict/from_dict stay for callers that want them.

const BUSES := ["Sfx", "Music", "Ambient"]   # Master always exists
const POOL_SIZE := 12                          # per pool (2D and 3D)
const SILENT_DB := -80.0

var last_played := ""                          # name of the last play() call, for tests and debug

var _cache := {}                               # cache key -> AudioStreamWAV
var _pool_2d: Array[AudioStreamPlayer] = []
var _pool_3d: Array[AudioStreamPlayer3D] = []
var _next_2d := 0
var _next_3d := 0
var _ambient_player: AudioStreamPlayer
var _ambient_kind := ""
var _rng := RandomNumberGenerator.new()


func _ready() -> void:
	_rng.randomize()
	_setup_buses()
	for i in POOL_SIZE:
		var p := AudioStreamPlayer.new()
		p.bus = "Sfx"
		add_child(p)
		_pool_2d.append(p)
		var p3 := AudioStreamPlayer3D.new()
		p3.bus = "Sfx"
		add_child(p3)
		_pool_3d.append(p3)
	_ambient_player = AudioStreamPlayer.new()
	_ambient_player.bus = "Ambient"
	add_child(_ambient_player)
	_connect_hooks()


func reset() -> void:
	stop_all()


func to_dict() -> Dictionary:
	var volumes := {}
	for bus_name in ["Master"] + BUSES:
		volumes[bus_name] = get_volume(bus_name)
	return {"volumes": volumes}


func from_dict(d: Dictionary) -> void:
	var volumes: Dictionary = d.get("volumes", {})
	for bus_name in volumes:
		set_volume(bus_name, float(volumes[bus_name]))


# ---- buses -----------------------------------------------------------------

func _setup_buses() -> void:
	for bus_name in BUSES:
		if AudioServer.get_bus_index(bus_name) != -1:
			continue
		AudioServer.add_bus()
		var idx := AudioServer.bus_count - 1
		AudioServer.set_bus_name(idx, bus_name)
		AudioServer.set_bus_send(idx, "Master")


## Sets a bus volume from 0 (silent) to 1 (full). Returns false for an unknown bus.
func set_volume(bus_name: String, volume: float) -> bool:
	var idx := AudioServer.get_bus_index(bus_name)
	if idx == -1:
		push_warning("Sfx.set_volume: no bus named %s" % bus_name)
		return false
	var v := clampf(volume, 0.0, 1.0)
	AudioServer.set_bus_volume_db(idx, SILENT_DB if v <= 0.0 else maxf(linear_to_db(v), SILENT_DB))
	return true


## Current bus volume on the same 0..1 scale as set_volume (0 if unknown).
func get_volume(bus_name: String) -> float:
	var idx := AudioServer.get_bus_index(bus_name)
	if idx == -1:
		return 0.0
	return db_to_linear(AudioServer.get_bus_volume_db(idx))


# ---- one-shot playback -----------------------------------------------------

## Builds (or returns the cached) stream for a one-shot name. zombie_groan
## takes variant 0..2. Returns null for an unknown name.
func build(name: String, variant: int = 0) -> AudioStreamWAV:
	if not (name in SfxSynth.SOUND_NAMES):
		push_warning("Sfx: unknown sound %s" % name)
		return null
	var v := variant if name == "zombie_groan" else 0
	var key := "%s_%d" % [name, v]
	if not _cache.has(key):
		var samples := SfxSynth.render(name, v)
		if samples.is_empty():
			return null
		_cache[key] = SfxSynth.make_wav(samples)
	return _cache[key]


## Plays a one-shot. With a position it uses a 3D player at that point, otherwise
## a 2D player. zombie_groan picks a random variant. Returns false if no sound
## was played (unknown name).
func play(name: String, position: Vector3 = Vector3.INF, volume_db: float = 0.0) -> bool:
	last_played = name
	var variant := _rng.randi_range(0, SfxSynth.GROAN_VARIANTS - 1) if name == "zombie_groan" else 0
	var stream := build(name, variant)
	if stream == null:
		return false
	if position == Vector3.INF:
		var p := _take_2d()
		p.stream = stream
		p.volume_db = volume_db
		p.play()
	else:
		var p3 := _take_3d()
		p3.stream = stream
		p3.volume_db = volume_db
		p3.global_position = position
		p3.play()
	return true


func stop_all() -> void:
	for p in _pool_2d:
		p.stop()
		p.stream = null
	for p in _pool_3d:
		p.stop()
		p.stream = null
	stop_ambient()
	last_played = ""


## Pool sizes, for tests: players created and how many are currently playing.
func pool_stats() -> Dictionary:
	var playing := 0
	for p in _pool_2d:
		playing += 1 if p.playing else 0
	for p in _pool_3d:
		playing += 1 if p.playing else 0
	return {"size": _pool_2d.size() + _pool_3d.size(), "playing": playing}


func _take_2d() -> AudioStreamPlayer:
	for i in _pool_2d.size():
		var idx := (_next_2d + i) % _pool_2d.size()
		if not _pool_2d[idx].playing:
			_next_2d = idx + 1
			return _pool_2d[idx]
	# All busy: steal the next one in rotation.
	var stolen := _pool_2d[_next_2d % _pool_2d.size()]
	_next_2d += 1
	stolen.stop()
	return stolen


func _take_3d() -> AudioStreamPlayer3D:
	for i in _pool_3d.size():
		var idx := (_next_3d + i) % _pool_3d.size()
		if not _pool_3d[idx].playing:
			_next_3d = idx + 1
			return _pool_3d[idx]
	var stolen := _pool_3d[_next_3d % _pool_3d.size()]
	_next_3d += 1
	stolen.stop()
	return stolen


# ---- ambient loops ---------------------------------------------------------

## Starts a looping drone: "street", "interior" or "night". volume_db sets the
## loop's own level; use set_volume("Ambient", v) for the bus. Returns false for
## an unknown kind.
func start_ambient(kind: String, volume_db: float = -6.0) -> bool:
	if not (kind in SfxSynth.AMBIENT_KINDS):
		push_warning("Sfx: unknown ambient kind %s" % kind)
		return false
	if _ambient_kind != kind or not _ambient_player.playing:
		var key := "ambient_" + kind
		if not _cache.has(key):
			var samples := SfxSynth.render_ambient(kind)
			_cache[key] = SfxSynth.make_wav(samples, SfxSynth.AMBIENT_RATE, true)
		_ambient_player.stream = _cache[key]
		_ambient_player.play()
	_ambient_player.volume_db = volume_db
	_ambient_kind = kind
	return true


func stop_ambient() -> void:
	_ambient_player.stop()
	_ambient_player.stream = null
	_ambient_kind = ""


func is_ambient_playing() -> bool:
	return _ambient_player.playing


func ambient_kind() -> String:
	return _ambient_kind


# ---- Events hooks ----------------------------------------------------------

func _connect_hooks() -> void:
	var events := get_node_or_null("/root/Events")
	if events == null:
		push_warning("Sfx: Events autoload missing, no hooks connected")
		return
	_hook(events, "shot_fired", _on_shot_fired)
	_hook(events, "player_damaged", _on_player_damaged)
	_hook(events, "player_died", _on_player_died)
	_hook(events, "enemy_killed", _on_enemy_killed)
	_hook(events, "level_up", _on_level_up)
	_hook(events, "item_used", _on_item_used)
	_hook(events, "container_searched", _on_container_searched)
	# Taking things (containers, shop, quest rewards): the Inventory signal.
	# Inventory is registered after Sfx, so connect once the tree is up.
	_connect_inventory.call_deferred()


func _connect_inventory() -> void:
	var inv := get_node_or_null("/root/Inventory")
	if inv != null and inv.has_signal("item_added") and not inv.is_connected("item_added", _on_item_added):
		inv.connect("item_added", _on_item_added)


func _on_item_added(_item_name: String) -> void:
	play("pickup")


func _hook(events: Node, signal_name: String, handler: Callable) -> void:
	if not events.has_signal(signal_name):
		push_warning("Sfx: Events has no signal %s" % signal_name)
		return
	if not events.is_connected(signal_name, handler):
		events.connect(signal_name, handler)


## Maps a weapon_ref (weapon type or item name) to a gunshot sound name.
static func gunshot_for(weapon_ref: String) -> String:
	var lower := weapon_ref.to_lower()
	for kw in ["shotgun", "pump", "12ga"]:
		if kw in lower:
			return "shotgun_shot"
	for kw in ["smg", "automatic", "uzi", "mp5", "venom"]:
		if kw in lower:
			return "smg_shot"
	for kw in ["rifle", "longgun", "sniper", "ak47", "m16", "fal", "hellslinger"]:
		if kw in lower:
			return "rifle_shot"
	return "pistol_shot"


func _on_shot_fired(weapon_ref: String, _noise: float, position: Vector3) -> void:
	play(gunshot_for(weapon_ref), position)


func _on_player_damaged(_amount: float, _source: Node) -> void:
	play("player_hurt")


func _on_player_died() -> void:
	play("player_death")


func _on_enemy_killed(_enemy_ref: String, _danger: int, _xp: int) -> void:
	play("zombie_death")


func _on_level_up(_new_level: int) -> void:
	play("level_up")


func _on_item_used(_item_name: String) -> void:
	play("pickup")


func _on_container_searched(_container_id: String) -> void:
	play("pickup")
